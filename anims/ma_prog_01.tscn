[sub_resource type="Resource" id="Resource_n8gkq"]
script = ExtResource("2_v5427")
entries = PackedStringArray("What Is Programming?", "What Is AI-assisted coding?", "in how many ways you can do each?", "Just like a tree grows its branches", "so can coding be in any direction", "> from low-level to high-level\n> with electronics or with websites\n> data warehouses or proxy services\n> consultation or solution implementation", "       Just like a cup of water\ncan be filled to different amounts", "so does AI-assistance is\nused at various amounts", "AI can assist with:\n> searching a knowledge base\n> learning to solve a problem\n> finding a problem    > solving the problem\n> never letting you see a problem\n> forgetting codebase", "coding", "coding w/ ai")

